# Copy to .env (never commit .env). Read only by the agent server, never by the browser.
# Setup steps (where each value comes from): README.md → "Supabase və Resend".

# --- AI provider ---
# anthropic (Claude, default) or gemini (Google Gemini). Setup steps: README.md → "AI provayderi".
AI_PROVIDER=anthropic
# Needed when AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Needed when AI_PROVIDER=gemini: Google AI Studio → Create API key
GEMINI_API_KEY=
# Optional: Gemini model (default gemini-3.8-flash)
# GEMINI_MODEL=gemini-3.8-flash
# Optional: Gemini model to switch to when GEMINI_MODEL stays overloaded (503) after all retries
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# Optional: automatic retries on overload, rate limit or a dropped connection (default 3, 0 = off)
# AI_MAX_RETRIES=3

# --- Database: Supabase (Postgres) ---
# Supabase → Connect → Session pooler connection string, with your database password.
# Empty = local SQLite file (data/arachi.db), for development without Supabase.
DATABASE_URL=
# Optional: path to the Supabase CA certificate (Project Settings → Database → SSL) for full TLS verification
# DATABASE_SSL_CA=
# DATABASE_POOL_SIZE=5

# --- Email: Resend ---
# Resend → API Keys. Empty = emails are only written to the server log and the outbox table.
RESEND_API_KEY=
# Sender on a domain verified in Resend → Domains, e.g. Arachi <rfq@yourdomain.com>
EMAIL_FROM=
# Optional: where carriers' email replies go (your real inbox)
EMAIL_REPLY_TO=
# Optional: Resend → Webhooks → your endpoint → Signing secret (whsec_...), once the app is hosted.
# Bounces are also picked up without it by polling Resend (needs a "Full access" API key).
# RESEND_WEBHOOK_SECRET=

# Optional overrides
# Claude model and effort, when AI_PROVIDER=anthropic
# AGENT_MODEL=claude-opus-5-5
# AGENT_EFFORT=medium
# PORT=8787
# ARACHI_DB_PATH=data/arachi.db
# Public address of the app, used in every link it sends (carrier quote links,
# password reset, RFQ/panel pages). Default: http://localhost:5173 locally.
# On the VPS leave it out: docker-compose.yml sets it to https://APP_DOMAIN.
# PUBLIC_BASE_URL=http://localhost:5173
# VPS only (docker-compose.yml): the app's domain, without https://. Caddy gets
# its HTTPS certificate for it. Hosting steps: docs/DEPLOY.md.
# APP_DOMAIN=app.v2.arachi.co
# VPS only: anyone may create an account (default on the VPS: only the first account; locally: open)
# ALLOW_SIGNUP=true
# VPS only: how many daily database backups to keep in ./backups (default 14)
# BACKUP_KEEP=14
# Folder of the built UI that the server serves in production (npm run build)
# STATIC_DIR=dist
# Secret for signing carrier links (generated and stored in the DB if empty)
# ARACHI_LINK_SECRET=
