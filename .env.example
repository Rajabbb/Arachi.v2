# Copy to .env (never commit .env). Read only by the agent server, never by the browser.
ANTHROPIC_API_KEY=
# Optional overrides
# AGENT_MODEL=claude-opus-5-5
# AGENT_EFFORT=medium
# PORT=8787
# ARACHI_DB_PATH=data/arachi.db
# Address of the UI, used in links sent to carriers
# PUBLIC_BASE_URL=http://localhost:5173
# Secret for signing carrier links (generated and stored in the DB if empty)
# ARACHI_LINK_SECRET=
